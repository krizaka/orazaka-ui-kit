{
  "name": "orazaka-ui-kit",
  "private": true,
  "description": "Development workspace of @krizaka/orazaka-shared and @krizaka/orazaka-design-system.",
  "workspaces": [
    "orazaka-shared",
    "orazaka-design-system"
  ],
  "scripts": {
    "build": "npm run build --workspace=@krizaka/orazaka-shared",
    "validate": "npm run build --workspace=@krizaka/orazaka-shared && npm run validate --workspace=@krizaka/orazaka-design-system",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,mjs,cjs,json,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,mjs,cjs,json,css}\""
  },
  "devDependencies": {
    "@krizaka/config": "^0.18.0",
    "prettier": "^3.9.10"
  }
}
