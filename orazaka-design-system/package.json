{
  "name": "@krizaka/orazaka-design-system",
  "version": "3.4.1",
  "description": "The Orazaka identity on the Krizaka platform: the Orazaka Orange theme (the Orazaka brand of @krizaka/tokens) and its named themes as --kz-* token overrides, the product composites (ChatShowcase, CommandPalette, SentinelMini, icon registry) with their documentation registry (krizaka.com/docs/orazaka/ui), and the @krizaka/ui primitives re-exported.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/krizaka/orazaka-ui-kit.git",
    "directory": "orazaka-design-system"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "src",
    "!src/**/__tests__",
    "registry",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./theme.css": "./src/theme.css",
    "./registry/examples/*": "./registry/examples/*.tsx",
    "./registry/*": "./registry/*",
    "./package.json": "./package.json"
  },
  "scripts": {
    "lint": "eslint src registry --max-warnings 0 && krizaka-ratchet",
    "typecheck": "tsc --noEmit",
    "test": "jest && node --test scripts/registry.test.mjs scripts/platform-versions.test.mjs",
    "test:coverage": "jest --coverage",
    "publint": "publint",
    "check": "npm run lint && npm run typecheck && npm test && npm run registry && npm run publint",
    "validate": "npm run check",
    "registry": "node scripts/build-registry.mjs",
    "prepack": "node scripts/build-registry.mjs"
  },
  "dependencies": {
    "@krizaka/icons": "^0.7.0",
    "@krizaka/orazaka-shared": "^1.1.0",
    "@krizaka/tailwind": "^3.28.0",
    "@krizaka/tokens": "^3.28.0",
    "@krizaka/ui": "^3.28.0",
    "tailwind-variants": "^3.3.1"
  },
  "peerDependencies": {
    "next": ">=15",
    "react": ">=19",
    "react-dom": ">=19",
    "tailwindcss": "^4.1"
  },
  "devDependencies": {
    "@krizaka/config": "^0.4.1",
    "@swc/core": "^1.7.0",
    "@swc/jest": "^0.2.37",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/jest": "^30.0.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^10.12.0",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "next": "^16.3.0",
    "publint": "^0.3.25",
    "react": "19.2.4",
    "react-docgen-typescript": "^2.4.0",
    "react-dom": "19.2.4",
    "tailwindcss": "^4.1.0",
    "typescript": "^6"
  },
  "keywords": [
    "orazaka",
    "krizaka",
    "design-system",
    "theme",
    "design-tokens",
    "react",
    "nextjs",
    "tailwindcss",
    "tailwind-v4"
  ],
  "homepage": "https://github.com/krizaka/orazaka-ui-kit/tree/main/orazaka-design-system#readme",
  "bugs": "https://github.com/krizaka/orazaka-ui-kit/issues",
  "author": "Krizaka (https://www.krizaka.com)",
  "sideEffects": [
    "*.css"
  ],
  "engines": {
    "node": ">=20"
  }
}
